    font-family: 'PlainPixel-Regular';
    src: url(data:font/woff2;charset=utf-8;base64,) format('woff2');
}

/* Apply the custom font to the specified HTML elements */
/* Title of the project if there's no banner */
.header h1 {
    font-family: PlainPixel-Regular;
    font-weight: normal;
    text-align: center;
    font-size: 16pt;
 
}

.user_formatted h1 {
    font-size: 24pt;
    font-weight: normal;
    color: #009B95;
}

/* Page content including description, more information, download, devlogs, comments, etc */
.left_col.column {
    font-family: PlainPixel-Regular;
    font-size: 16pt;
}

/* Footer (bottom of the page) that shows: ITCH.IO--VIEW ALL BY CREATOR--REPORT--EMBED      TYPE*GENRE*PRICE */
.footer a {
    font-family: PlainPixel-Regular;
}

/* Last updated timestamp in the footer after EMBED */
.update_timestamp {
    font-family: PlainPixel-Regular;
}

.view_game_page .header_buy_row {
    display: inline;
    font-family: PlainPixel-Regular;
    font-size: 16pt;
}

.direct_download_btn {
    font-family: PlainPixel-Regular;
    display:inline;
}

.download_instructions h2 {
    font-size: 24pt;
    font-weight: normal;
    color: #009B95;
}

.uploads h2 {
    font-size: 24pt;
    font-weight: normal;
    color: #009B95;
}

.game_devlog h2 {
    font-size: 24pt;
    font-weight: normal;
    color: #009B95;
}

.game_comments_widget h2 {
    font-size: 24pt;
    font-weight: normal;
    color: #009B95;
}</style></head><body class=" locale_en game_layout_widget layout_widget responsive no_theme_toggle" data-host="itch.io" data-page_name="view_game"><ul class="user_tools hidden" id="user_tools"><li><a class="action_btn view_more" href="https://burpyfresh.itch.io"><svg class="svgicon icon_itchio_new" role="img" height="16" width="18" viewBox="0 0 262.728 235.452" version="1.1" aria-hidden><path d="M31.99 1.365C21.287 7.72.2 31.945 0 38.298v10.516C0 62.144 12.46 73.86 23.773 73.86c13.584 0 24.902-11.258 24.903-24.62 0 13.362 10.93 24.62 24.515 24.62 13.586 0 24.165-11.258 24.165-24.62 0 13.362 11.622 24.62 25.207 24.62h.246c13.586 0 25.208-11.258 25.208-24.62 0 13.362 10.58 24.62 24.164 24.62 13.585 0 24.515-11.258 24.515-24.62 0 13.362 11.32 24.62 24.903 24.62 11.313 0 23.773-11.714 23.773-25.046V38.298c-.2-6.354-21.287-30.58-31.988-36.933C180.118.197 157.056-.005 122.685 0c-34.37.003-81.228.54-90.697 1.365zm65.194 66.217a28.025 28.025 0 0 1-4.78 6.155c-5.128 5.014-12.157 8.122-19.906 8.122a28.482 28.482 0 0 1-19.948-8.126c-1.858-1.82-3.27-3.766-4.563-6.032l-.006.004c-1.292 2.27-3.092 4.215-4.954 6.037a28.5 28.5 0 0 1-19.948 8.12c-.934 0-1.906-.258-2.692-.528-1.092 11.372-1.553 22.24-1.716 30.164l-.002.045c-.02 4.024-.04 7.333-.06 11.93.21 23.86-2.363 77.334 10.52 90.473 19.964 4.655 56.7 6.775 93.555 6.788h.006c36.854-.013 73.59-2.133 93.554-6.788 12.883-13.14 10.31-66.614 10.52-90.474-.022-4.596-.04-7.905-.06-11.93l-.003-.045c-.162-7.926-.623-18.793-1.715-30.165-.786.27-1.757.528-2.692.528a28.5 28.5 0 0 1-19.948-8.12c-1.862-1.822-3.662-3.766-4.955-6.037l-.006-.004c-1.294 2.266-2.705 4.213-4.563 6.032a28.48 28.48 0 0 1-19.947 8.125c-7.748 0-14.778-3.11-19.906-8.123a28.025 28.025 0 0 1-4.78-6.155 27.99 27.99 0 0 1-4.736 6.155 28.49 28.49 0 0 1-19.95 8.124c-.27 0-.54-.012-.81-.02h-.007c-.27.008-.54.02-.813.02a28.49 28.49 0 0 1-19.95-8.123 27.992 27.992 0 0 1-4.736-6.155zm-20.486 26.49l-.002.01h.015c8.113.017 15.32 0 24.25 9.746 7.028-.737 14.372-1.105 21.722-1.094h.00