# game/scripts/days/day 2.rpy:321

translate thai day2_pierdate_05abd787:

    # y "H-Huh? Never mind!"
    y "อ-อะ? ไม่มีอะไร!"

# game/scripts/days/day 2.rpy:324

translate thai day2_pierdate_34602a45:

    # r "Y-Yeah?"
    r "อ-อ่า?"

# game/scripts/days/day 2.rpy:325

