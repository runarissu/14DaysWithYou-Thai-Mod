# game/scripts/days/day 0.rpy:758

translate thai eastereggalternative_8a7b7ef5:

    # n "I watch Rosie, my other co-worker, punch Saint in the stomach with zero remorse. Was she always that strong?" with vpunch
    n "ฉันมอง Rosie เพื่อนร่วมงานอีกคนของฉัน ต่อย Saint เข้าที่ท้องโดยไม่ไยดีเลยสักนิด เธอแข็งแรงขนาดนี้มาตลอดเหรอ?" with vpunch

# game/scripts/days/day 0.rpy:760

translate thai eastereggalternative_d71ad914:

