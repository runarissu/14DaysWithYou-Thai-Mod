# game/scripts/days/day 1.rpy:46
translate thai day1_callren_24202482:

    # n "*ring*… *ring*… *ring*…"
    n "*ริง*… *ริง*… *ริง*…"

# game/scripts/days/day 1.rpy:1862
translate thai day1_callren_224d4a93:

    # n "It barely rings three times before he picks up, and he seems almost… flustered and out of breath."
    n "โทรไม่ถึงสามครั้งเขาก็รับสายแล้ว และเขาดูเหมือนจะ… ตื่นเต้นและเหนื่อยจนหายใจไม่ทัน"

# game/scripts/days/day 1.rpy:1863
translate thai day1_callren_449fd8df:

    # rcall "H-Hello? This… This is [ch_angel], right?"
    rcall "ส-สวัสดี? นี่… นี่ [ch_angel] ใช่มั้ย?"

# game/scripts/days/day 1.rpy:1872
translate thai day1_callren_4e519758:

    # rcall "O-Oh, yeah! No worries, hahaha! Thanks for… uh, thanks for calling! Wow… your voice sounds just as lovely on the phone."
    rcall "อ-โอ ใช่! ไม่เป็นไร ฮ่าๆๆ! ขอบคุณที่… อ่ะ ขอบคุณที่โทรมานะ! ว้าว… เสียงคุณก็ไพเราะไม่แพ้ตอนคุยผ่านโทรศัพท์เลย"

# game/scripts/days/day 1.rpy:1873
translate thai day1_callren_6513b8f8:

    # y "Oh, uh… Thank you?"
    y "อ่ะ อืม… ขอบคุณ?"

# game/scripts/days/day 1.rpy:1874
translate thai day1_callren_40f12176:

    # rcall "Wait, no, that's not what I—… I-I didn't mean to— …Sorry, I wasn't thinking when I said that."
    rcall "เอ่อ ไม่ ฉันไม่ได้จะ—… ฉ-ฉันไม่ได้ตั้งใจ— …ขอโทษ ฉันพูดไปโดยไม่คิด"

# game/scripts/days/day 1.rpy:1878
translate thai day1_callren_0918c738:

    # rcall "Ah-! I mean, I wasn't really expecting anyone to ring, so I kind of just… assumed."
    rcall "อ่ะ-! คือว่า ฉันไม่ได้คาดหวังว่าจะมีใครโทรมา ก็เลยตะ… คิดไปเอง"

# game/scripts/days/day 1.rpy:1879
translate thai day1_callren_b7578430:

    # extend " Not that many people ring me anyway, haha."
    extend " ก็ไม่ค่อยมีคนโทรหาฉันอยู่แล้วนะ ฮ่าๆ"

# game/scripts/days/day 1.rpy:1880
translate thai day1_callren_e17e712f:

    # rcall "…Sorry, did I make it weird?"
    rcall "…ขอโทษ ฉันทำให้มันแปลกไปเหรอ?"

# game/scripts/days/day 1.rpy:1884
translate thai day1_callren_da457ac7:

    # rcall "No! I-It's fine! I'm normally still awake at this time anyway. I usually like to watch some things before I fall asleep."
    rcall "ไม่! ม-มันไม่เป็นไร! ฉันก็ตื่นอยู่ช่วงเวลานี้อยู่แล้ว ฉันมักจะดูอะไรบางอย่างก่อนนอน"

# game/scripts/days/day 1.rpy:1885
translate thai day1_callren_de7b65b0:

    # rcall "Sometimes it keeps me up until the morning, but I don't really mind. I feel at ease when I get to look at y—"
    rcall "บางครั้งฉันก็ดูจนเช้าเลย แต่ฉันก็ไม่ค่อยว่างะ ฉันรู้สึกสบายใจเวลาได้มองคุ—"

# game/scripts/days/day 1.rpy:1886
translate thai day1_callren_c859e53f:

    # extend " {b}{i}stuff.{/i}{/b}"
    extend " {b}{i}ของพวกนั้น.{/i}{/b}"

# game/scripts/days/day 1.rpy:1887
translate thai day1_callren_f0edda77:

    # y "Oh, really? Like… movies or something? What do you normally like to watch? Maybe I've seen it!"
    y "โอ จริงเหรอ? คือ… หนังอะไรพวกนั้น? ปกติชอบดูอะไร? บางทีฉันอาจเคยดู!"

# game/scripts/days/day 1.rpy:1888
translate thai day1_callren_3fc2cb03:

    # rcall "…Movies? Why would I— {b}OH.{/b} Y-Yeah! It's some niche film you might not have heard about… M-Maybe we could watch it together sometime."
    rcall "…หนัง? ทำไมฉันจะ— {b}อ๊ะ.{/b} อ-ใช่! เป็นหนังเฉพาะกลุ่มที่คุณอาจไม่เคยได้ยิน… บ-บางทีเราอาจดูด้วยกันได้บางที"

# game/scripts/days/day 1.rpy:1889
translate thai day1_callren_96b90de9:

    # rcall "Sorry, I made it awkward again, didn't I?"
    rcall "ขอโทษ ฉันทำให้มันแปลกอีกแล้วใช่มั้ย?"

# game/scripts/days/day 1.rpy:1893
translate thai day1_callren_cfc035ea:

    # rcall "…Hello? Are you there? I-I don't think I can hear you…"
    rcall "…สวัสดี? ยังอยู่มั้ย? ฉ-ฉันไม่ได้ยินเสียงคุณ…"

# game/scripts/days/day 1.rpy:1894
translate thai day1_callren_0a1e1229:

    # rcall "Did you meant to call me? …Hello?"
    rcall "คุณตั้งใจโทรมาหาฉันเหรอ? …สวัสดี?"

# game/scripts/days/day 1.rpy:1895
translate thai day1_callren_a506e366:

    # y "…"
    y "…"

# game/scripts/days/day 1.rpy:1896
translate thai day1_callren_599f6f4a:

    # rcall "Hellooooooooo! Are you there?"
    rcall "สวัสดีีีีี! ยังอยู่มั้ย?"

# game/scripts/days/day 1.rpy:1897
translate thai day1_callren_a535a3f7:

    # n "Deciding to put him out of his misery, I finally speak up."
    n "ฉันตัดสินใจพูดขึ้นมาเพื่อจบความทุกข์ของเขา"

# game/scripts/days/day 1.rpy:1898
translate thai day1_callren_43bce9a0:

    # y "Hey [ch_ren]…"
    y "เฮ้ [ch_ren]…"

# game/scripts/days/day 1.rpy:1899
translate thai day1_callren_ecee40c4:

    # rcall "Oh, [ch_angel]! S-Sorry! I couldn't hear you earlier. I guess there must be something wrong with my phone, aha."
    rcall "โอ [ch_angel]! ข-ขอโทษ! ฉันไม่ได้ยินคุณเมื่อกี้ คงมีอะไรผิดปกติกับโทรศัพท์ฉัน ฮ่าๆ"

# game/scripts/days/day 1.rpy:1900
translate thai day1_callren_66712cd0:

    # rcall "Sorry… {i}Again{/i}."
    rcall "ขอโทษ… {i}อีกแล้ว{/i}"

# game/scripts/days/day 1.rpy:1904
translate thai day1_callren_965a5db4:

    # y "It's okay, don't worry about it. "
    y "ไม่เป็นไร ไม่ต้องห่วง "

# game/scripts/days/day 1.rpy:1905
translate thai day1_callren_109659c9:

    # n "He's really been apologising a lot today — I almost feel bad for him."
    n "วันนี้เขาขอโทษฉันตลอดเลย — ฉันเกือบจะสงสารเขาแล้ว"

# game/scripts/days/day 1.rpy:1906
translate thai day1_callren_983d8891:

    # rcall "Actually… I'm surprised you called. I honestly expected you to throw away my note, to be honest."
    rcall "จริงๆ… ฉันก็แปลกใจที่คุณโทรมา ฉันคิดว่าคุณคงทิ้งกระดาษโน้ตของฉันไปแล้วสิ"

# game/scripts/days/day 1.rpy:1907
translate thai day1_callren_6bd9d8a6:

    # rcall "I hope you didn't find it creepy or anything. Your… {i}workmate{/i} seemed like the type to tease you if I handed it to her instead, so I figured that leaving it on your desktop would've been the wiser choice."
    rcall "ฉันหวังว่าคุณจะไม่คิดว่ามันน่าขยะแขยงนะ คน… {i}ที่ทำงานด้วย{/i} ของคุณดูเหมือนจะเป็นคนชอบแกล้งคุณ ถ้าฉันเอาไปให้เขาแทน ฉันเลยคิดว่าเอาไว้บนโต๊ะคุณน่าจะฉลาดกว่า"

# game/scripts/days/day 1.rpy:1908
translate thai day1_callren_1d15436b:

    # rcall "But then I was worried she might come back and find it before you did, so I considered putting it in your bag instead. But then I thought—"
    rcall "แต่แล้วฉันก็กังวลว่าเขาอาจกลับมาและเจอมันก่อนคุณ ฉันเลยคิดจะเอาใส่กระเป๋าคุณแทน แต่แล้วฉันก็คิดว่า—"

# game/scripts/days/day 1.rpy:1909
translate thai day1_callren_3e80e4e4:

    # rcall "I guess I'm rambling now, aren't I? Sorry!"
    rcall "ฉันคงพูดเพ้อเจ้อไปแล้วใช่มั้ย? ขอโทษ!"

# game/scripts/days/day 1.rpy:1910
translate thai day1_callren_61ab5363:

    # rcall "A-Anyway, I also wanted to know if… Well— If you were free tomorrow? I still wanted to thank you for helping me find that book."
    rcall "อ-เอาเป็นว่า ฉันอยากรู้ว่า… อืม— คุณว่างพรุ่งนี้มั้ย? ฉันยังอยากขอบคุณที่ช่วยหาหนังสือเล่มนั้นให้อยู่"

# game/scripts/days/day 1.rpy:1911
translate thai day1_callren_16bdd973:

    # n "…Oh? Was he asking me out on a date? Or was I reading too deep into his words? He must've taken my silence as confusion, however, as he immediately begins to backtrack on his words."
    n "…โอ? เขากำลังชวนฉันไปเดทเหรอ? หรือฉันคิดมากไปเอง? แต่เขาคงเข้าใจความเงียบของฉันผิด เพราะเขารีบถอยคำพูดทันที"

# game/scripts/days/day 1.rpy:1912
translate thai day1_callren_8321abe6:

    # rcall "I-I guess I'm asking you out on a date, haha! We could… We could go visit the pier, or the beach, or this café I know… Honestly, we could do whatever you'd like! I don't mind at all."
    rcall "ฉ-ฉันกำลังชวนคุณไปเดทนะ ฮ่าๆ! เราจะ… เราจะไปเดินท่าเรือ หรือชายหาด หรือคาเฟ่ที่ฉันรู้จักก็ได้… จริงๆ จะทำอะไรก็ได้ตามที่คุณอยาก! ฉันไม่ว่าอะไรเลย"

# game/scripts/days/day 1.rpy:1913
translate thai day1_callren_dafc150a:

    # y "Well…"
    y "ก็…"

# game/scripts/days/day 1.rpy:1914
translate thai day1_callren_599fc48d:

    # n "So he wanted to go on a date? Well… It wasn't like I had anything planned for tomorrow; it was my day off, after all. Maybe it wouldn't be so bad?"
    n "งั้นเขาอยากไปเดท? ก็… ฉันก็ไม่ได้มีอะไรทำพรุ่งนี้อยู่แล้ว วันหยุดของฉันนี่นา ไปเดทก็คงไม่เลวใช่มั้ย?"

# game/scripts/days/day 1.rpy:1915
translate thai day1_callren_c5e28867:

    # n "Besides, I can't even remember the last time I went out with someone — let alone a date."
    n "อีกอย่าง ฉันจำไม่ได้แล้วด้วยว่าครั้งสุดท้ายที่ไปไหนกับใครคือตอนไหน — ยิ่งเดทด้วยแล้ว"

# game/scripts/days/day 1.rpy:1916
translate thai day1_callren_49701b4b:

    # n "Yeah, maybe going on a date with him wouldn't be such a bad idea. Besides, [ch_ren] didn't seem {b}that bad{/b} of a guy. I could even use this as an opportunity to get to know him better. He certainly seemed interesting."
    n "ใช่ ไปเดทกับเขาก็คงไม่ใช่ความคิดแย่หรอก อีกอย่าง [ch_ren] ก็ไม่ได้ดูเป็นคน {b}เลวร้าย{/b} ขนาดนั้น ฉันจะถือโอกาสนี้ทำความรู้จักเขาให้มากขึ้นก็ได้ เขาดูน่าสนใจอยู่เหมือนจริง"

# game/scripts/days/day 1.rpy:1917
translate thai day1_callren_486b4e70:

    # y "Sure, why not? It sounds like it'd be fun. And I haven't visited the pier in a while."
    y "ได้สิ ทำไมจะไม่ได้ ดูจะสนุกดี แล้วฉันก็ไม่ได้ไปท่าเรือมานานแล้วด้วย"

# game/scripts/days/day 1.rpy:1918
translate thai day1_callren_cb22cacf:

    # rcall "Y-You really want to go on a date?!"
    rcall "ค-คุณจะไปเดทจริงๆเหรอ?!"

# game/scripts/days/day 1.rpy:1919
translate thai day1_callren_36ac4668:

    # rcall "I-I mean, yeah! Cool! …Would it be alright if I pick you up around eleven, then?"
    rcall "ฉ-ฉันหมายถึง ใช่! เจ๋ง! …ฉันไปรับคุณประมาณสิบเอ็ดโมงก็ได้นะ?"

# game/scripts/days/day 1.rpy:1920
translate thai day1_callren_edfd6b87:

    # y "Yeah, sure."
    y "อืม ได้"

# game/scripts/days/day 1.rpy:1921
translate thai day1_callren_511e0862:

    # n "Wow, he really seemed eager. I hope I didn't make the wrong choice by agreeing to this."
    n "ว้าว เขาดูกระตือรือร้นจริงๆ ฉันหวังว่าจะไม่ได้ตัดสินใจผิดที่ตกลงไป"

# game/scripts/days/day 1.rpy:1922
translate thai day1_callren_e20e4cd1:

    # rcall "A-Alright then, yeah! Great!"
    rcall "อ-ก็ตกลงนะ! เยี่ยม!"

# game/scripts/days/day 1.rpy:1923
translate thai day1_callren_7def4374:

    # n "He was perhaps a bit {b}too{/b} eager."
    n "เขาอาจจะกระตือรือร้น {b}ไป{/b} สักหน่อย"

# game/scripts/days/day 1.rpy:1924
translate thai day1_callren_8dc2e56c:

    # rcall "…A-Anyway, it's getting late now, isn't it? I'm sure I've already taken up too much of your time. I'll… I'll let you go to sleep, then."
    rcall "…อ-เอาเป็นว่า ดึกแล้วสินะ? ฉันคงเสียเวลาคุณไปเยอะแล้ว ฉันจะ… ฉันจะวางสายให้คุณไปนอนแล้วนะ"

# game/scripts/days/day 1.rpy:1931
translate thai day1_callren_d50af186:

    # rcall "{size=+10}A-A-Ah! Really?!{/size}" with vpunch
    rcall "{size=+10}อ-อ-อ๊ะ! จริงๆเหรอ?!{/size}" with vpunch

# game/scripts/days/day 1.rpy:1932
translate thai day1_callren_18c74d0c:

    # extend " Me… Me too! But… you need to sleep, don't you? I won't be greedy. Can I… {i}err,{/i} would it be okay if I called you tomorrow?"
    extend " ฉัน… ฉันก็เหมือนกัน! แต่… คุณต้องนอนแล้วใช่มั้ย? ฉันจะไม่เสียเวลาคุณ ฉันจะ… {i}อ่ะ,{/i} ฉันโทรหาคุณพรุ่งนี้ได้มั้ย?"

# game/scripts/days/day 1.rpy:1933
translate thai day1_callren_379a5907:

    # y "Sure, we can talk more about our date then."
    y "ได้สิ ค่อยคุยเรื่องเดทกันตอนนั้น"

# game/scripts/days/day 1.rpy:1934
translate thai day1_callren_47070fd2:

    # rcall "O-Okay, yeah! Sweet! I mean—"
    rcall "อ-โอเค ใช่! เยี่ยม! คือว่า—"

# game/scripts/days/day 1.rpy:1935
translate thai day1_callren_8d74e142:

    # rcall "Ugh, I'll just… I'll let you go to sleep before I embarrass myself {i}further{/i}."
    rcall "เฮ้อ ฉันจะ… ฉันจะวางสายให้คุณไปนอนก่อนที่ฉันจะทำให้ตัวเอง {i}น่าอาย{/i} มากไปกว่านี้"

# game/scripts/days/day 1.rpy:1936
translate thai day1_callren_9b8f1efb:

    # rcall "Goodnight [ch_angel]. Sweet dreams."
    rcall "อรุณสวัสดิ์ [ch_angel] ขอให้ฝันดีนะ"

# game/scripts/days/day 1.rpy:1941
translate thai day1_callren_86c4fa53:

    # n "The sound of a muffled squeak erupts from his end before [ch_ren] clears his throat once more."
    n "เสียงร้องเบาๆ ดังมาจากฝั่งเขาก่อนที่ [ch_ren] จะกระแอมอีกครั้ง"

# game/scripts/days/day 1.rpy:1942
translate thai day1_callren_51de63d5:

    # rcall "{size=+10}Y-Yes please!{/size}" with vpunch
    rcall "{size=+10}อ-ได้เลย!{/size}" with vpunch

# game/scripts/days/day 1.rpy:1943
translate thai day1_callren_50a16c6f:

    # rcall "I mean, now that I have your number as well, would it be okay if I called {i}you{/i}?"
    rcall "คือว่า ตอนนี้ฉันมีเบอร์คุณด้วยแล้ว ฉันโทรหา {i}คุณ{/i} ได้มั้ย?"

# game/scripts/days/day 1.rpy:1944
translate thai day1_callren_fd304d33:

    # rcall "I'd love that… Wait, no— I mean—"
    rcall "ฉันอยากให้— เอ่อ ไม่— คือว่า—"

# game/scripts/days/day 1.rpy:1946
translate thai day1_callren_682b8995:

    # rcall "G-Goodnight!"
    rcall "อ-อรุณสวัสดิ์!"

# game/scripts/days/day 1.rpy:1955
translate thai day1_callren_571213a1:

    # n "He sounds almost {i}chipper{/i} at the sound of my voice, but I decide against questioning it. He really was a rather eccentric person."
    n "เขาดู {i}ร่าเริง{/i} ผิดปกติเวลาได้ยินเสียงฉัน แต่ฉันตัดสินใจไม่ถาม เขาเป็นคนแปลกจริงๆ"

# game/scripts/days/day 1.rpy:1956
translate thai day1_callren_4a360310:

    # rcall "…Can I… Can I still call you tomorrow, [ch_angel]? Or— No, never mind! Goodnight!"
    rcall "…ฉันจะ… ฉันโทรหาคุณพรุ่งนี้ได้มั้ย [ch_angel]? หรือ— ไม่ ไม่เป็นไร! อรุณสวัสดิ์!"

# game/scripts/days/day 1.rpy:1957
translate thai day1_callren_6638e7ce:

    # n "He hangs up before I can even respond."
    n "เขาวางสายก่อนที่ฉันจะทันตอบ"

# game/scripts/days/day 1.rpy:1960
translate thai day1_callren_36badfcd:

    # n "Deciding not to respond, I keep my mouth shut and listen to [ch_ren] awkwardly fumble on the other side of the line."
    n "ฉันตัดสินใจไม่ตอบ แล้วนั่งฟัง [ch_ren] พูดอยู่อย่างกระอักกระอ่วนอยู่อีกฝั่งสาย"

# game/scripts/days/day 1.rpy:1961
translate thai day1_callren_58be2786:

    # rcall "…Angel? Are you still there?"
    rcall "…Angel? ยังอยู่มั้ย?"

# game/scripts/days/day 1.rpy:1962
translate thai day1_callren_2b8da93c:

    # rcall "Ah— Don't tell my my phone isn't working again… Here, why don't I try calling you back and—"
    rcall "อ่ะ— อย่าบอกนะว่าโทรศัพท์ฉันเสียอีกแล้ว… เอานี่ ฉันลองโทรกลับให้ดูแล้วกันแล้ว—"

# game/scripts/days/day 1.rpy:1963
translate thai day1_callren_e7d418dd:

    # n "Before [ch_ren] could finish his sentence, I impulsively hang up the phone with a sigh."
    n "ก่อนที่ [ch_ren] จะพูดจบประโยค ฉันวางสายทันทีพร้อมกับถอนหายใจ"

# game/scripts/days/day 1.rpy:1964
translate thai day1_callren_c98bd9c7:

    # y "You sure like to talk a lot, huh?"
    y "คุณชอบพูดเยอะจังเลยนะ"

# game/scripts/days/day 1.rpy:1967
translate thai day1_callren_4cdabcad:

    # n "Placing my phone on the nightstand, I begin to slip into my bed and pull the covers over my body."
    n "ฉันวางโทรศัพท์บนโต๊ะข้างเตียง แล้วค่อยๆ ขึ้นไปนอนบนเตียงพร้อมรูดผ้าห่มคลุมตัว"

# game/scripts/days/day 1.rpy:1968
translate thai day1_callren_7b831e7b:

    # n "A beat passes before [ch_ren]'s soft, breathy voice enters my mind, and I slowly find myself getting lulled to sleep with it."
    n "ผ่านไปครู่หนึ่ง เสียงเบาๆ ของ [ch_ren] ดังขึ้นในหัวฉัน และฉันค่อยๆ หลับไปพร้อมกับเสียงนั้น"

# game/scripts/days/day 1.rpy:1969
translate thai day1_callren_12084f45:

    # n "So… {i}[ch_ren]{/i}, huh? I wonder what you have planned for us tomorrow."
    n "งั้น… {i}[ch_ren]{/i} สินะ? สงสัยว่าคุณจะมีอะไรเตรียมไว้ให้เราพรุ่งนี้"

# game/scripts/days/day 1.rpy:1981
