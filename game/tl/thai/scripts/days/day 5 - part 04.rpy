translate thai day5_teoalive_50658009:

    # j "[ch_angel]? And… Ron, right? Hey, hey, hey!" with vpunch
    j "[ch_angel]? แล้วก็... Ron ใช่มั้ง? เฮ้ เฮ้ เฮ้!" with vpunch

# game/scripts/days/day 5.rpy:741

translate thai day5_teoalive_d3a298cb:

    # n "A familiar voice calls out from somewhere behind us before [ch_jae] emerges from one of the buildings and jogs towards us with a bounce in his step."
    n "เสียงคุ้นเคยดังมาจากด้านหลัง ก่อนที่ [ch_jae] จะเดินออกมาจากตึกหลังหนึ่งแล้ววิ่งเข้ามาหาเราอย่างกระตือรือร้น"

